<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Выбор телевизора (всегда сверху) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="6dp"
                android:text="ТВ:"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/tvSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnFind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Найти" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Не подключено"
            android:textStyle="italic" />

        <!-- IP вручную (когда ТВ не нашёлся поиском) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/ipInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="IP вручную (напр. 192.168.1.225)"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Подключ." />
        </LinearLayout>

        <!-- Приложения -->
        <Button
            android:id="@+id/btnApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Приложения на ТВ (список)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Тап по приложению — запуск на ТВ. Список получаем от ТВ; если прошивка его не отдаёт — показываем найденные популярные приложения."
            android:textSize="12sp" />

        <!-- Текст на ТВ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/textInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Текст для ТВ"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отправить" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сначала откройте на ТВ поле ввода (например, поиск), затем отправьте текст."
            android:textSize="12sp" />

        <!-- Питание: одна кнопка — вкл (Wake-on-LAN) / выкл (каскад ключей для любой прошивки) -->
        <Button
            android:id="@+id/btnPowerOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="POWER — вкл/выкл ТВ (удерживать — MAC)" />

        <!-- Громкость и каналы -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TableRow android:weightSum="2">
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_VOLUP"
                    android:text="VOL +" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_CHUP"
                    android:text="CH +" />
            </TableRow>

            <TableRow android:weightSum="2">
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_VOLDOWN"
                    android:text="VOL −" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_CHDOWN"
                    android:text="CH −" />
            </TableRow>
        </TableLayout>

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:onClick="onKeyClick"
            android:tag="KEY_MUTE"
            android:text="MUTE (звук вкл/выкл)" />

        <!-- Навигационный крест -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TableRow android:weightSum="3">
                <Space android:layout_weight="1" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_UP"
                    android:text="▲" />
                <Space android:layout_weight="1" />
            </TableRow>

            <TableRow android:weightSum="3">
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_LEFT"
                    android:text="◀" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_ENTER"
                    android:text="OK" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_RIGHT"
                    android:text="▶" />
            </TableRow>

            <TableRow android:weightSum="3">
                <Space android:layout_weight="1" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_DOWN"
                    android:text="▼" />
                <Space android:layout_weight="1" />
            </TableRow>
        </TableLayout>

        <!-- Тачпад/мышь (v2.8): Tizen — настоящий курсор на ТВ, старые ТВ — свайп-стрелки -->
        <Button
            android:id="@+id/btnTouchpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Тачпад / мышь на ТВ" />

        <!-- Основные кнопки -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TableRow android:weightSum="3">
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_HOME"
                    android:text="HOME" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_RETURN"
                    android:text="Назад" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_EXIT"
                    android:text="Exit" />
            </TableRow>

            <TableRow android:weightSum="3">
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_HDMI_1"
                    android:text="HDMI 1" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_HDMI_2"
                    android:text="HDMI 2" />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:onClick="onKeyClick"
                    android:tag="KEY_HDMI_3"
                    android:text="HDMI 3" />
            </TableRow>
        </TableLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Первое подключение: ТВ покажет запрос — нажмите «Разрешить» на экране ТВ. Старые ТВ (2011–2015) подключаются через порт 55000 — на ТВ может появиться окно подтверждения."
            android:textSize="12sp" />

        <!-- Журнал связи с ТВ (открывается в отдельном окне, не прыгает) -->
        <Button
            android:id="@+id/btnLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Журнал связи с ТВ (лог)" />

        <!-- Проверка обновлений: GitHub Releases -> скачивание -> установка -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Проверить обновления приложения" />

        <TextView
            android:id="@+id/versionView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:text="Версия 2.2"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
